table Fact_Sales
	lineageTag: 37a3971b-7464-4cc2-afc9-7f9353e8bcf3

	measure 'Total Sales' =
			
			SUM(Fact_Sales[sales_amount])
		lineageTag: ca32ecf8-03b9-4dc6-ae1d-1673150e8883

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Quantity' =
			
			SUM(Fact_Sales[quantity])
		formatString: 0
		lineageTag: d33e4592-6542-46b3-8f3f-7fd7d140f3aa

	measure 'MoM Growth %' =
			
			VAR CurrentSales = [Total Sales]
			VAR PreviousMonthSales =
			    CALCULATE(
			        [Total Sales],
			        DATEADD(Dim_Date[Date], -1, MONTH)
			    )
			RETURN
			    DIVIDE(
			        CurrentSales - PreviousMonthSales,
			        PreviousMonthSales
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2e71a4cb-8457-412a-b0fa-5fcd57b79018

	measure 'Running Total Sales' =
			
			CALCULATE(
			    [Total Sales],
			    FILTER(
			        ALL(Dim_Date[Date]),
			        Dim_Date[Date] <= MAX(Dim_Date[Date])
			    )
			)
		lineageTag: 40df8960-2664-4e4d-a2c5-c20222d383ba

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'City Sales Rank' =
			
			RANKX(
			    ALL(Dim_City[City]),
			    [Total Sales],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		lineageTag: 084fdbf4-8d32-46a9-a4ad-8e32099de1f0

	measure 'Average Sales per Transaction' =
			
			DIVIDE(
			    [Total Sales],
			    DISTINCTCOUNT(Fact_Sales[date])
			)
		lineageTag: d2e4a80d-83fc-4b44-9b09-3a4472f13398

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column sale_id
		dataType: int64
